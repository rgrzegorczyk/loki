upgradeScript "Version 24.1.1: Lock Package" (
    execution {
        sequence: 20
    }
    script {
        contentFile: version-24-1-1-lock-package.sql
    }
    serverSideCondition {
        type: expression
        plsqlExpression: check_version(i_version => '24.1.1')
    }
)

upgradeScript "Version 24.1.1: Set Version" (
    execution {
        sequence: 30
    }
    script {
        contentFile: version-24-1-1-set-version.sql
    }
)

upgradeScript "Version 24.1.1: Util Package" (
    execution {
        sequence: 10
    }
    script {
        contentFile: version-24-1-1-util-package.sql
    }
    serverSideCondition {
        type: expression
        plsqlExpression: check_version(i_version => '24.1.1')
    }
)

