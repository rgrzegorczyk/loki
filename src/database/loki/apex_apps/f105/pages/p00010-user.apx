page 10 (
    name: User
    alias: USER
    title: User Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region user (
        name: User
        type: form
        source {
            location: localDatabase
            tableName: LOKI_USERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10_ACTIVE_YN (
        type: switch
        label {
            label: Active
            alignment: left
        }
        layout {
            sequence: 100
            region: @user
            slot: regionBody
            alignment: left
            columnSpan: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @user
            column: ACTIVE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
    )

    pageItem P10_ADMIN_YN (
        type: switch
        label {
            label: Admin
            alignment: left
        }
        layout {
            sequence: 110
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @user
            column: ADMIN_YN
            dataType: varchar2
        }
    )

    pageItem P10_APEX_USERNAME (
        type: textField
        label {
            label: APEX Username
            alignment: left
        }
        settings {
            trimSpaces: none
            textCase: upper
        }
        layout {
            sequence: 50
            region: @user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user
            column: APEX_USERNAME
            dataType: varchar2
        }
        help {
            helpText: Loki uses the APEX username to identify the user when the developer uses SQL Workshop
        }
    )

    pageItem P10_CREATED (
        type: datePicker
        label {
            label: Created
            alignment: left
        }
        layout {
            sequence: 130
            region: @user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: &G_DATE_TIME_FORMAT.
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user
            column: CREATED
            dataType: timestampWithLocalTimeZone
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_USER_ID
        }
        readOnly {
            type: always
        }
    )

    pageItem P10_CREATED_BY (
        type: textField
        label {
            label: Created By
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 140
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user
            column: CREATED_BY
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_USER_ID
        }
        readOnly {
            type: always
        }
    )

    pageItem P10_DATE_TIME_FORMAT (
        type: textField
        label {
            label: Date Time Format
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user
            column: DATE_TIME_FORMAT
            dataType: varchar2
        }
        default {
            type: static
            staticValue: YYYY/MM/DD HH:MI:SS PM
        }
        help {
            helpText: Loki uses the Date Time Format to localize dates in the interface for each developer
        }
    )

    pageItem P10_DB_USERNAME (
        type: textField
        label {
            label: DB Username
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user
            column: DB_USERNAME
            dataType: varchar2
        }
        help {
            helpText: Loki uses the DB username to identify the user when the developer uses SQL Developer or SQLcl/SQL*Plus
        }
    )

    pageItem P10_FULL_NAME (
        type: textField
        label {
            label: Full Name
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user
            column: FULL_NAME
            dataType: varchar2
        }
    )

    pageItem P10_TIME_ZONE (
        type: popupLov
        label {
            label: Time Zone
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @timezones
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user
            column: TIME_ZONE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: UTC
        }
        help {
            helpText: Loki uses Time Zone to adjust dates in the UI for each developer
        }
    )

    pageItem P10_UPDATED (
        type: datePicker
        label {
            label: Updated
            alignment: left
        }
        layout {
            sequence: 150
            region: @user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: &G_DATE_TIME_FORMAT.
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user
            column: UPDATED
            dataType: timestampWithLocalTimeZone
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_USER_ID
        }
        readOnly {
            type: always
        }
    )

    pageItem P10_UPDATED_BY (
        type: textField
        label {
            label: Updated By
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 160
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user
            column: UPDATED_BY
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_USER_ID
        }
        readOnly {
            type: always
        }
    )

    pageItem P10_USER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @user
            slot: regionBody
        }
        source {
            formRegion: @user
            column: USER_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P10_USER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_USER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_USER_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation date-time-format-is-valid (
        name: Date time format is valid
        execution {
            sequence: 30
        }
        validation {
            type: plsqlError
            plsqlCodeRaisingError:
                ```plsql
                declare
                  l_date_string varchar2(255);
                begin
                  l_date_string := to_char(sysdate, :P10_DATE_TIME_FORMAT);
                end;
                ```
        }
        error {
            errorMessage: The #LABEL# specified is not valid.
            associatedItem: @P10_DATE_TIME_FORMAT
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :request in ('CREATE','SAVE')
        }
    )

    validation no-active-locks (
        name: No active locks
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select *
                  from loki_locks
                 where user_id = :P10_USER_ID
                ```
        }
        error {
            errorMessage: This user has active locks and can't be deleted. Release the locks first.
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    validation time-zone-is-valid (
        name: Time zone is valid
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from v$timezone_names
                 where tzname = :P10_TIME_ZONE
                ```
        }
        error {
            errorMessage: The #LABEL# specified is not valid.
            associatedItem: @P10_TIME_ZONE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :request in ('CREATE','SAVE')
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 17861477187107770
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-user (
        name: Initialize form USER
        type: formInitialization
        formRegion: @user
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17842076168185526
        }
    )

    process process-form-user (
        name: Process form User
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :request = 'CREATE' then
                  insert into loki_users (
                    full_name,
                    apex_username,
                    db_username,
                    active_yn,
                    admin_yn,
                    time_zone,
                    date_time_format
                  )
                  values (
                    :p10_full_name,
                    :p10_apex_username,
                    :p10_db_username,
                    :p10_active_yn,
                    :p10_admin_yn,
                    :p10_time_zone,
                    :p10_date_time_format
                  );
                elsif :request = 'SAVE' then
                  update loki_users 
                     set full_name         = :p10_full_name,
                         apex_username     = :p10_apex_username,
                         db_username       = :p10_db_username,
                         active_yn         = :p10_active_yn,
                         admin_yn          = :p10_admin_yn,
                         time_zone         = :p10_time_zone,
                         date_time_format  = :p10_date_time_format,
                         updated           = localtimestamp,
                         updated_by        = loki_util.get_session_user()
                   where user_id = :p10_user_id;
                elsif :request = 'DELETE' then
                  delete from loki_users 
                   where user_id = :p10_user_id;
                end if;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 20266513810647101
        }
    )

)

