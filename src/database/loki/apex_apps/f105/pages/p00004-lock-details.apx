    pageItem P4_USER_ID (
        type: selectList
        label {
            label: User
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @loki-users-full-name
        }
        layout {
            sequence: 50
            region: @lock-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @lock-details
            column: USER_ID
            dataType: number
        }
        readOnly {
            type: always
        }
    )

    pageItem P4_USER_ID_LOG (
        type: popupLov
        label {
            label: User
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @loki-users-full-name
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @lock-log-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
