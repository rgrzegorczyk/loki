        }
        source {
            formRegion: @lock-log-details
            column: LOCKS_LOG_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P4_LOCK_ID (
        type: hidden
        layout {
