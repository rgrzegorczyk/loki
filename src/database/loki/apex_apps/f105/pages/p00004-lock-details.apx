page 4 (
    name: Lock Details
    alias: LOCK-DETAILS
    title: Lock Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region lock-details (
        name: Lock Details
        type: form
        source {
            location: localDatabase
            tableName: LOKI_LOCKS
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P4_LOCK_STATUS
            value: Active
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region lock-log-details (
        name: Lock Log Details
        type: form
        source {
            location: localDatabase
            tableName: LOKI_LOCKS_LOGS
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P4_LOCK_STATUS
            value: Inactive
        }
    )

    pageItem P4_CREATED (
        type: datePicker
        label {
            label: Created
            alignment: left
        }
        layout {
            sequence: 60
            region: @lock-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: &G_DATE_TIME_FORMAT.
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @lock-details
            column: CREATED
            dataType: timestampWithLocalTimeZone
        }
        readOnly {
            type: always
        }
    )

    pageItem P4_CREATED_BY (
        type: textField
        label {
            label: Created by
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @lock-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @lock-details
            column: CREATED_BY
            dataType: varchar2
        }
        readOnly {
            type: always
        }
    )

    pageItem P4_DDL_LOG_ID (
        type: hidden
        layout {
            sequence: 100
            region: @lock-details
            slot: regionBody
        }
        source {
            formRegion: @lock-details
            column: DDL_LOG_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P4_DDL_LOG_ID_LOG (
        type: hidden
        layout {
            sequence: 120
            region: @lock-log-details
            slot: regionBody
        }
        source {
            formRegion: @lock-log-details
            column: DDL_LOG_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P4_LOCKED (
        type: datePicker
        label {
            label: Locked
            alignment: left
        }
        layout {
            sequence: 70
            region: @lock-log-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @lock-log-details
            column: LOCKED
            dataType: timestampWithLocalTimeZone
        }
        readOnly {
            type: always
        }
    )

    pageItem P4_LOCKED_BY (
        type: textField
        label {
            label: Locked By
            alignment: left
        }
        layout {
            sequence: 80
            region: @lock-log-details
            slot: regionBody
            alignment: left
