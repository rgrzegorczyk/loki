page 11 (
    name: User Profile
    alias: USER-PROFILE
    title: User Profile
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region user-profile (
        name: User Profile
        type: form
        source {
            location: localDatabase
            tableName: LOKI_USERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P11_ACTIVE_YN (
        type: switch
        label {
            label: Active
            alignment: left
        }
        layout {
            sequence: 60
            region: @user-profile
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @user-profile
            column: ACTIVE_YN
            dataType: varchar2
        }
    )

    pageItem P11_ADMIN_YN (
        type: selectList
        label {
            label: Admin
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @yn
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 160
            region: @user-profile
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @user-profile
            column: ADMIN_YN
            dataType: varchar2
        }
        readOnly {
            type: always
        }
    )

    pageItem P11_APEX_USERNAME (
        type: textField
        label {
            label: APEX Username
            alignment: left
        }
        settings {
            trimSpaces: none
            textCase: upper
        }
        layout {
            sequence: 140
            region: @user-profile
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: APEX_USERNAME
            dataType: varchar2
        }
        readOnly {
            type: always
        }
        help {
            helpText: Loki uses the APEX username to identify the user when the developer uses SQL Workshop
        }
    )

    pageItem P11_CREATED (
        type: datePicker
        label {
            label: Created
            alignment: left
        }
        layout {
            sequence: 170
            region: @user-profile
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: &G_DATE_TIME_FORMAT.
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: CREATED
            dataType: timestampWithLocalTimeZone
        }
        readOnly {
            type: always
        }
    )

    pageItem P11_CREATED_BY (
        type: textField
        label {
            label: Created By
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 180
            region: @user-profile
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: CREATED_BY
            dataType: varchar2
        }
        readOnly {
            type: always
        }
    )

    pageItem P11_DATE_TIME_FORMAT (
        type: textField
        label {
            label: Date Time Format
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @user-profile
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: DATE_TIME_FORMAT
            dataType: varchar2
        }
        default {
            type: static
            staticValue: YYYY/MM/DD HH:MI:SS PM
        }
        help {
            helpText: Loki uses the Date Time Format to localize dates in the interface for each developer
        }
    )

    pageItem P11_DB_USERNAME (
        type: textField
        label {
            label: DB Username
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 150
            region: @user-profile
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: DB_USERNAME
            dataType: varchar2
        }
        readOnly {
            type: always
        }
        help {
            helpText: Loki uses the DB username to identify the user when the developer uses SQL Developer or SQLcl/SQL*Plus
        }
    )

    pageItem P11_FULL_NAME (
        type: textField
        label {
            label: Full Name
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @user-profile
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: FULL_NAME
            dataType: varchar2
        }
    )

    pageItem P11_TIME_ZONE (
        type: popupLov
        label {
            label: Time Zone
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @timezones
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @user-profile
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: TIME_ZONE
            dataType: varchar2
        }
        help {
            helpText: Loki uses Time Zone to adjust dates in the UI for each developer
        }
    )

    pageItem P11_UPDATED (
        type: datePicker
        label {
            label: Updated
            alignment: left
        }
        layout {
            sequence: 190
            region: @user-profile
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: &G_DATE_TIME_FORMAT.
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: UPDATED
            dataType: timestampWithLocalTimeZone
        }
        readOnly {
            type: always
        }
    )

    pageItem P11_UPDATED_BY (
        type: textField
        label {
            label: Updated By
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 200
            region: @user-profile
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @user-profile
            column: UPDATED_BY
            dataType: varchar2
        }
        readOnly {
            type: always
        }
    )

    pageItem P11_USER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @user-profile
            slot: regionBody
        }
        source {
            formRegion: @user-profile
            column: USER_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_USER_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation date-time-format-is-valid (
        name: Date time format is valid
        execution {
            sequence: 20
        }
        validation {
            type: plsqlError
            plsqlCodeRaisingError:
                ```plsql
                declare
                  l_date_string varchar2(255);
                begin
                  l_date_string := to_char(sysdate, :P11_DATE_TIME_FORMAT);
                end;
                ```
        }
        error {
            errorMessage: The #LABEL# specified is not valid.
            associatedItem: @P11_DATE_TIME_FORMAT
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :request in ('CREATE','SAVE')
        }
    )

    validation time-zone-is-valid (
        name: Time zone is valid
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from v$timezone_names
                 where tzname = :P11_TIME_ZONE
                ```
        }
        error {
            errorMessage: The #LABEL# specified is not valid.
            associatedItem: @P11_TIME_ZONE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :request in ('CREATE','SAVE')
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 18635874612385424
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-user-profile (
        name: Initialize form User Profile
        type: formInitialization
        formRegion: @user-profile
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18635074794385423
        }
    )

    process process-form-user-profile (
        name: Process form User Profile
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update loki_users 
                   set full_name         = :p11_full_name,
                       active_yn         = :p11_active_yn,
                       time_zone         = :p11_time_zone,
                       date_time_format  = :p11_date_time_format,
                       updated           = localtimestamp,
                       updated_by        = loki_util.get_session_user()
                 where user_id = :p11_user_id;
                
                :g_date_time_format := :p11_date_time_format;
                apex_util.set_session_time_zone(:p11_time_zone);
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 18635436409385424
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

