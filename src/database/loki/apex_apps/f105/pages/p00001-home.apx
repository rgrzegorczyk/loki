    process get-filtered-locks (
        name: get_filtered_locks
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_context   apex_exec.t_context;
                  l_page_id   apex_application_page_regions.page_id%type;
                  l_region_id apex_application_page_regions.region_id%type;
                  l_response  json_object_t := json_object_t();
                begin
                  l_response.put('result', true);
                
                  begin
                    select page_id, region_id
                      into l_page_id, l_region_id
                      from apex_application_page_regions
                     where application_name = 'Loki'
                       and page_name = 'Locks'
                       and static_id = 'loki__locks-list';
                    
                    l_context := apex_region.open_query_context(
                      p_page_id     => l_page_id,
                      p_region_id   => l_region_id
                    );
                
                    apex_collection.create_or_truncate_collection(
                      p_collection_name => 'LOKI_FILTERED_LOCKS'
                    );
                
                    while apex_exec.next_row(l_context) loop
                      if apex_exec.get_varchar2(
                          p_context     => l_context, 
                          p_column_name => 'STATUS'
                        ) = 'Active' then
                
                        apex_collection.add_member(
                          p_collection_name => 'LOKI_FILTERED_LOCKS',
                          p_c001            => apex_exec.get_varchar2(
                            p_context     => l_context,
                            p_column_name => 'LOCK_ID'
                          ),
                          p_c002            => apex_exec.get_varchar2(
                            p_context     => l_context,
                            p_column_name => 'USER_ID'
                          )
                        );
                      end if;
                    end loop;
                
                    l_response.put('count', apex_collection.collection_member_count(
                      p_collection_name => 'LOKI_FILTERED_LOCKS'
                    ));
                    
                  exception 
                    when no_data_found then
                      l_response.put('count', 0);
                    when others then
                      l_response.put('result', false);
                      l_response.put('msg', substr(sqlerrm(), 1, 2000));
                  end;
                
                  htp.p(l_response.to_clob());
                end;
                ```
        }
        execution {
            sequence: 50
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 15628218640587121
        }
    )

    process transfer-lock (
        name: transfer_lock
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_response json_object_t := json_object_t();
                begin
                  l_response.put('result', true);
                
                  begin
                    -- Transfer one lock
                    loki_lock.transfer_lock(
                      i_lock_id => apex_application.g_x01,
                      i_user_id => apex_application.g_x02
                    );
                    commit;
                  exception when others then
                    l_response.put('result', false);
                    l_response.put('msg', substr(sqlerrm(), 1, 2000));
                  end;
                
                  htp.p(l_response.to_clob());
                end;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 13228001885743714
        }
    )

    process transfer-locks (
        name: transfer_locks
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_response json_object_t := json_object_t();
                  l_lock_ids apex_t_number;
                begin
                  l_response.put('result', true);
                
                  begin
                    select c001 as lock_id
                      bulk collect into l_lock_ids
                      from apex_collections
                     where collection_name = 'LOKI_FILTERED_LOCKS';
                
                    loki_lock.transfer_locks(
                      i_lock_ids   => l_lock_ids,
                      i_to_user_id => apex_application.g_x01
                    );
                    commit;
                
                    apex_collection.delete_collection(
                      p_collection_name => 'LOKI_FILTERED_LOCKS'
                    );
                  exception when others then
                    rollback;
                    l_response.put('result', false);
                    l_response.put('msg', substr(sqlerrm(), 1, 2000));
                  end;
                
                  htp.p(l_response.to_clob());
                end;
                ```
        }
        execution {
            sequence: 40
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 15627767838587116
        }
    )

