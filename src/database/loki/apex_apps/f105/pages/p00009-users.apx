page 9 (
    name: Users
    alias: USERS
    title: &APP_NAME. - Users
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region users (
        name: Users
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select USER_ID,
                       FULL_NAME,
                       APEX_USERNAME,
                       DB_USERNAME,
                       admin_yn,
                       active_yn
                  from LOKI_USERS
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 17862424196107793
        }

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Active
                alignment: center
            }
            layout {
                sequence: 64
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                      SUCCESS:=#ACTIVE_YN#
                    {apply THEME$LOKI_YES_NO_COLUMN/}
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ADMIN_YN (
            type: plainText
            heading {
                heading: Admin
                alignment: center
            }
            layout {
                sequence: 54
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                      SUCCESS:=#ADMIN_YN#
                    {apply THEME$LOKI_YES_NO_COLUMN/}
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column APEX_USERNAME (
            type: plainText
            heading {
                heading: APEX Username
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DB_USERNAME (
            type: plainText
            heading {
                heading: DB Username
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column FULL_NAME (
            type: link
            heading {
                heading: Full Name
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 10
                    items: {
                        P10_USER_ID: #USER_ID#
                    }
                }
                linkText: #FULL_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column USER_ID (
            type: hidden
            heading {
                heading: User ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Users
        }

        savedReport 178754 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVE_YN (
                sequence: 4
            )

            displayColumn ADMIN_YN (
                sequence: 5
            )

            displayColumn APEX_USERNAME (
                sequence: 2
            )

            displayColumn DB_USERNAME (
                sequence: 3
            )

            displayColumn FULL_NAME (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @breadcrumb
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                clearCache: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset
        layout {
            sequence: 10
            region: @users
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: [
                    &APP_PAGE_ID.
                    RIR
                ]
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-dialog-closed (
        name: Create - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @breadcrumb
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @users
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @users
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @users
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

